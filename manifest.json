{
  "manifest_version": 3,
  "name": "Entry Info Bot - 이야기 예약",
  "version": "2.2.1",
  "description": "다른 사용자의 최근 엔트리이야기 글에 제한적 댓글 작성, 본인 글 새 글 예약",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://playentry.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/community/entrystory/list*"
      ],
      "js": [
        "core.js",
        "auth.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Entry Info Bot 설정",
    "default_popup": "popup.html"
  }
}
