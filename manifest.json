{
  "manifest_version": 3,
  "name": "Entry Info Bot - 이야기 예약",
  "version": "2.1.0",
  "description": "내 엔트리이야기 글 예약 댓글, 조건 진단, 선택적 새 글 자동 게시",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://playentry.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/community/entrystory/list*"
      ],
      "js": [
        "core.js",
        "auth.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Entry Info Bot 설정",
    "default_popup": "popup.html"
  }
}
